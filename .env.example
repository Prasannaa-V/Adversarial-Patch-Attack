# Copy to .env (root or dashboard/backend/) and edit. Never commit .env.
# Shared secret for Zero-Trust HMAC-SHA256 on smartgate/* MQTT + POST /api/events.
# Must match ESP32 HMAC_SECRET_KEY in esp32/firmware/src/main.cpp.
HMAC_SHARED_SECRET=smartgate_zero_trust_hmac_secret_2026

# Operator JWT auth (dashboard/backend/routes/*). Change in production.
JWT_SECRET=infraedge_secure_jwt_secret_key_2026

# Backend
PORT=3000
MQTT_URL=mqtt://localhost:1883
ALLOWED_ORIGINS=*
